---
// Self-contained section: third-party reviews and community integrations of
// FlyBeeper devices. Used as social proof on the FlyBeeper landing.
// No props, no fetches. Update items in the arrays below.

interface Item {
  title: string
  detail: string
  url?: string
  note?: string
}

const reviews: Item[] = [
  {
    title: 'testfly.me review of FlyBeeper mini BT',
    detail: 'Independent paragliding gear review. Score 8.38/10.',
    url: 'https://testfly.me/en/reports/devices/flybeeper-mini-bt/',
  },
  {
    title: 'paraglidingforum.com — mini BT & Pressure Sensor',
    detail: 'Community discussion thread covering both devices.',
    url: 'https://www.paraglidingforum.com/viewtopic.php?t=110815',
  },
  {
    title: 'paraglidingforum.com — Remote Control 4',
    detail: 'Community discussion thread for the RC4 button device.',
    url: 'https://www.paraglidingforum.com/viewtopic.php?t=112916',
  },
]

const integrations: Item[] = [
  {
    title: 'XCSoar',
    detail:
      'Open-source flight computer. Issue #1502 — BLE PS1 support (opened by Genajoin, 2024-06-13).',
    url: 'https://github.com/XCSoar/XCSoar/issues/1502',
  },
  {
    title: 'XCTrack',
    detail: 'Android flight app. Issue #1018 — FANET integration request.',
    url: 'https://gitlab.com/xcontest-public/xctrack-public/-/issues/1018',
  },
  {
    title: 'XCTrack',
    detail: 'Issue #1016 — RC4 button support request.',
    url: 'https://gitlab.com/xcontest-public/xctrack-public/-/issues/1016',
  },
  {
    title: 'SeeYou Navigator',
    detail: 'Naviter cross-country app. Supports FlyBeeper protocol.',
  },
  {
    title: 'LK8000',
    detail: 'Open-source flight instrument app. FlyBeeper compatible.',
  },
  {
    title: 'Flyskyhy',
    detail: 'iOS flight app. FlyBeeper BLE support.',
  },
]

const marketplace: Item[] = [
  {
    title: 'eBay listings',
    detail: 'Secondary-market presence — devices resold by owners.',
  },
]

function renderClass() {
  return 'text-blue-600 hover:text-blue-700 hover:underline font-medium'
}
---

<section class="max-w-5xl mx-auto px-6 py-16 border-t border-slate-200">
  <h2 class="text-2xl md:text-3xl font-bold text-slate-900 mb-3">
    Press &amp; Integrations
  </h2>
  <p class="text-slate-600 leading-relaxed mb-10 max-w-3xl">
    FlyBeeper devices in the wild — third-party reviews, community
    integrations, and app support.
  </p>

  <!-- Reviews & community -->
  <div class="mb-10">
    <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500 mb-4">
      Reviews &amp; community
    </h3>
    <div class="grid md:grid-cols-2 gap-4">
      {reviews.map((item) => (
        <div class="border border-slate-200 rounded-xl p-5 hover:border-slate-300 transition-colors">
          <h4 class="font-semibold text-slate-900 mb-1">
            {item.url ? (
              <a
                href={item.url}
                class={renderClass()}
                target="_blank"
                rel="noopener noreferrer"
              >
                {item.title}
              </a>
            ) : (
              <span>{item.title}</span>
            )}
          </h4>
          <p class="text-sm text-slate-600 leading-relaxed">{item.detail}</p>
          {item.note && (
            <p class="text-xs text-slate-400 italic mt-2">{item.note}</p>
          )}
        </div>
      ))}
    </div>
  </div>

  <!-- App integrations -->
  <div class="mb-10">
    <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500 mb-2">
      App integrations
    </h3>
    <p class="text-xs text-slate-500 mb-4 max-w-2xl">
      These apps support FlyBeeper devices over BLE. Listed entries are
      community integrations and open issue requests, not official endorsements.
    </p>
    <ul class="divide-y divide-slate-200 border-t border-b border-slate-200">
      {integrations.map((item) => (
        <li class="py-4 flex flex-col md:flex-row md:items-baseline md:gap-4">
          <div class="md:w-48 shrink-0 font-semibold text-slate-900">
            {item.url ? (
              <a
                href={item.url}
                class={renderClass()}
                target="_blank"
                rel="noopener noreferrer"
              >
                {item.title}
              </a>
            ) : (
              <span>{item.title}</span>
            )}
          </div>
          <div class="text-sm text-slate-600 leading-relaxed">
            {item.detail}
            {item.note && (
              <span class="block text-xs text-slate-400 italic mt-1">{item.note}</span>
            )}
          </div>
        </li>
      ))}
    </ul>
  </div>

  <!-- Marketplace -->
  <div>
    <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500 mb-4">
      Marketplace
    </h3>
    <ul class="divide-y divide-slate-200 border-t border-b border-slate-200">
      {marketplace.map((item) => (
        <li class="py-4 flex flex-col md:flex-row md:items-baseline md:gap-4">
          <div class="md:w-48 shrink-0 font-semibold text-slate-900">
            {item.url ? (
              <a
                href={item.url}
                class={renderClass()}
                target="_blank"
                rel="noopener noreferrer"
              >
                {item.title}
              </a>
            ) : (
              <span>{item.title}</span>
            )}
          </div>
          <div class="text-sm text-slate-600 leading-relaxed">
            {item.detail}
            {item.note && (
              <span class="block text-xs text-slate-400 italic mt-1">{item.note}</span>
            )}
          </div>
        </li>
      ))}
    </ul>
  </div>

  <p class="mt-8 text-xs text-slate-500 italic max-w-3xl">
    Trademarks and project names are the property of their respective owners.
    Mentions here reflect community use of FlyBeeper hardware and do not imply
    a formal partnership.
  </p>
</section>
