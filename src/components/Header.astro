---
const navLinks = [
  { href: '/#services', label: 'Services' },
  { href: '/blog', label: 'Blog' },
  { href: '/case-studies', label: 'Case Studies' },
  { href: '/about', label: 'About' },
  { href: 'mailto:info@alpisto.eu', label: 'Contact' },
]

const pathname = Astro.url.pathname
---

<header class="border-b border-slate-200">
  <div class="max-w-5xl mx-auto px-6 py-5">
    <nav class="flex items-center justify-between gap-4">
      <a href="/" class="font-semibold text-xl text-slate-900 hover:text-blue-600 transition-colors shrink-0">
        Alpisto
      </a>

      <!-- Desktop nav -->
      <ul class="hidden sm:flex items-center gap-6 text-sm font-medium text-slate-600">
        {navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class:list={[
                'hover:text-slate-900 transition-colors',
                (pathname === href || (href !== '/' && pathname.startsWith(href.replace('/#services', ''))))
                  ? 'text-slate-900'
                  : '',
              ]}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Mobile nav -->
      <details class="sm:hidden group relative">
        <summary class="list-none cursor-pointer p-2 text-slate-600 hover:text-slate-900">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-label="Menu">
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="18" x2="21" y2="18" />
          </svg>
        </summary>
        <ul class="absolute right-0 top-full mt-1 w-44 bg-white border border-slate-200 rounded-lg shadow-sm py-2 z-50">
          {navLinks.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-slate-900 transition-colors"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </nav>
  </div>
</header>
