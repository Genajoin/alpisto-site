---
import Page from './Page.astro'

interface Props {
  title: string
  description: string
  pubDate: Date
  updatedDate?: Date
  tags?: string[]
  heroImage?: string
}

const { title, description, pubDate, updatedDate, tags = [], heroImage } = Astro.props

const formattedPubDate = pubDate.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
---

<Page title={title} description={description} ogImage={heroImage}>
  <article class="max-w-3xl mx-auto px-6 py-16">
    <header class="mb-10">
      <div class="flex flex-wrap gap-2 mb-4">
        {tags.map(tag => (
          <span class="text-xs font-medium text-blue-600 bg-blue-50 px-2 py-0.5 rounded">
            {tag}
          </span>
        ))}
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">{title}</h1>
      <p class="text-slate-500 text-sm">
        Published <time datetime={pubDate.toISOString()}>{formattedPubDate}</time>
        {updatedDate && (
          <span> · Updated <time datetime={updatedDate.toISOString()}>{updatedDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}</time></span>
        )}
      </p>
    </header>
    <div class="prose prose-slate max-w-none">
      <slot />
    </div>
  </article>
</Page>
