---
import Page from './Page.astro'
import Eyebrow from '../components/v5/Eyebrow.astro'
import Tag from '../components/v5/Tag.astro'
import Btn from '../components/v5/Btn.astro'
import Subscribe from '../components/v5/Subscribe.astro'
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'blog'>
  readingTime: string
  headings?: Array<{ depth: number; slug: string; text: string }>
}

const { post, readingTime, headings = [] } = Astro.props
const { title, description, pubDate, updatedDate, tags, heroImage, ctaTarget, toc } = post.data

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })

const isoDate = (d: Date) => d.toISOString().slice(0, 10)

const tocHeadings = toc ? headings.filter(h => h.depth === 2 || h.depth === 3) : []

const ctaMap: Record<string, { eyebrow: string; title: string; body: string; label: string; href: string }> = {
  '/matlab-to-python': {
    eyebrow: '● Related service',
    title: 'Moving a MATLAB codebase to Python?',
    body:
      'Fixed-fee audit, then a numerically-equivalent port with CI tolerance gates. Same pattern we used on the case study linked above.',
    label: 'See the migration service →',
    href: '/matlab-to-python',
  },
  '/flybeeper': {
    eyebrow: '● Related product line',
    title: 'See the full FlyBeeper line-up.',
    body:
      'Eight BLE wearables built end-to-end — firmware, PCB, mobile, backend. Two shipping, five in development, one retired.',
    label: 'Browse devices →',
    href: '/flybeeper',
  },
  'https://market.flybeeper.com/device/sun-vario': {
    eyebrow: '● On sale',
    title: 'Order the FlyBeeper SunVario.',
    body:
      'A solar audio vario with a capacitor instead of a battery — nothing to charge, 60 seconds on USB-C for a flying day. Free shipping, first units shipped in the order payments come in.',
    label: 'Order the SunVario →',
    href: 'https://market.flybeeper.com/device/sun-vario',
  },
  'https://market.flybeeper.com/device/fanet-vario': {
    eyebrow: '● First batch shipping',
    title: 'Order the FlyBeeper FANET Vario.',
    body:
      'A solar FANET beacon and barometric vario in one — €149 with free shipping. A first batch of about ten units, shipped in the order payments come in.',
    label: 'Order the FlyBeeper FANET Vario →',
    href: 'https://market.flybeeper.com/device/fanet-vario',
  },
  'https://maps.flybeeper.com/?layers=fl&lat=46.14254&lng=9.51481&z=4.65&p=6': {
    eyebrow: '● Live on the map',
    title: 'See the flyability forecast for yourself.',
    body:
      'The link opens maps.flybeeper.com with the Flyability layer already on, centred on the model\u2019s whole coverage from Spain to Turkey. Day chips switch today and the three days ahead; every cell card shows tier probabilities and storm rows.',
    label: 'Open the Flyability map →',
    href: 'https://maps.flybeeper.com/?layers=fl&lat=46.14254&lng=9.51481&z=4.65&p=6',
  },
}
const ctaLink = ctaTarget ? ctaMap[ctaTarget] : undefined
const ctaExternal = ctaLink ? /^https?:\/\//.test(ctaLink.href) : false
---

<Page title={title} description={description} ogImage={heroImage ?? '/og-default.png'}>
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
    integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV"
    crossorigin="anonymous"
    slot="head"
  />

  {/* HERO */}
  <section class="px-5 sm:px-10 pt-8 sm:pt-10 pb-6">
    <Eyebrow>
      <span class="flex items-center gap-3"><span>●</span><span>BLOG / POST</span></span>
      <span class="flex items-center gap-3"><span>●</span><time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time></span>
      <span class="flex items-center gap-3"><span>●</span><span>{readingTime}</span></span>
      {updatedDate && (
        <span class="flex items-center gap-3"><span>●</span><span>Updated {formatDate(updatedDate)}</span></span>
      )}
    </Eyebrow>

    <h1
      class="font-display font-bold tracking-[-0.04em] leading-[0.95] text-ink mt-4 max-w-[1100px] text-[36px] sm:text-[56px] md:text-[72px] lg:text-[88px]"
    >
      {title}
    </h1>

    <p class="font-display text-[17px] sm:text-[20px] lg:text-[22px] leading-[1.45] text-ink-2 mt-6 max-w-[820px] font-medium">
      {description}
    </p>

    {tags.length > 0 && (
      <div class="mt-6 flex flex-wrap items-center gap-2">
        {tags.map(tag => (
          <a href={`/blog/tags/${tag}/`} class="no-underline">
            <Tag>#{tag}</Tag>
          </a>
        ))}
      </div>
    )}

    <div class="mt-7 pt-5 border-t-2 border-ink flex flex-wrap items-baseline gap-x-6 gap-y-2 font-mono text-[12px] uppercase tracking-[0.08em] text-ink-3">
      <span class="text-ink font-bold">↳ Evgeny Istomin</span>
      <span>Engineer · Alpisto d.o.o.</span>
      <span class="ml-auto">{readingTime}</span>
    </div>
  </section>

  {heroImage && (
    <section class="px-5 sm:px-10 pt-6">
      <figure class="border-2 border-ink bg-paper-card relative overflow-hidden">
        <img src={heroImage} alt="" class="block w-full h-auto" loading="lazy" />
      </figure>
    </section>
  )}

  {/* TOC + CONTENT */}
  <section class="px-5 sm:px-10 pt-10 sm:pt-14 pb-10">
    {tocHeadings.length > 0 ? (
      <div class="grid gap-8 lg:gap-12 lg:grid-cols-[1fr_220px]">
        <article class="prose-v5 max-w-[820px] min-w-0">
          <slot />
        </article>
        <aside class="lg:order-last order-first lg:sticky lg:top-8 lg:self-start">
          <details class="border-2 border-ink bg-paper-card" open>
            <summary class="cursor-pointer list-none px-4 py-3 border-b-2 border-ink bg-ink text-paper font-mono text-[11px] uppercase tracking-[0.12em] flex items-center justify-between">
              <span>● On this page</span>
              <span class="lg:hidden" aria-hidden="true">↕</span>
            </summary>
            <nav class="px-4 py-4">
              <ol class="list-none m-0 p-0 space-y-2 font-mono text-[12px] leading-[1.5]">
                {tocHeadings.map((h, i) => (
                  <li class={h.depth === 3 ? 'pl-4' : ''}>
                    <a
                      href={`#${h.slug}`}
                      class="text-ink-2 no-underline hover:text-accent block break-words"
                    >
                      <span class="text-ink-3 mr-2">{String(i + 1).padStart(2, '0')}</span>
                      {h.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </details>
        </aside>
      </div>
    ) : (
      <article class="prose-v5 max-w-[820px] mx-auto">
        <slot />
      </article>
    )}
  </section>

  {/* CTA */}
  {ctaLink && (
    <section class="px-5 sm:px-10 pt-2 pb-10">
      <div class="border-2 border-ink bg-accent p-6 sm:p-9 grid gap-6 lg:grid-cols-[1.4fr_1fr] lg:gap-10 lg:items-end">
        <div>
          <Eyebrow>{ctaLink.eyebrow}</Eyebrow>
          <h2
            class="font-display font-bold tracking-[-0.035em] leading-[0.95] mt-3 text-ink text-[32px] sm:text-[44px] lg:text-[56px]"
          >
            {ctaLink.title}
          </h2>
          <p class="font-display text-[15px] sm:text-[17px] text-ink mt-4 max-w-[560px] leading-[1.5]">
            {ctaLink.body}
          </p>
        </div>
        <div class="flex flex-wrap gap-3 lg:justify-end">
          <Btn
            kind="ink"
            href={ctaLink.href}
            target={ctaExternal ? '_blank' : undefined}
            rel={ctaExternal ? 'noopener' : undefined}
          >{ctaLink.label}</Btn>
        </div>
      </div>
    </section>
  )}

  {/* SUBSCRIBE */}
  <section class="px-5 sm:px-10 pb-12 sm:pb-14">
    <Subscribe />
  </section>

  {/* FOOTER NAV */}
  <section class="px-5 sm:px-10 pb-14 sm:pb-16">
    <div class="border-t-2 border-ink pt-6 flex flex-wrap items-center justify-between gap-4">
      <a
        href="/blog"
        class="font-mono text-[12px] uppercase tracking-[0.08em] text-ink no-underline hover:text-accent"
      >
        ← Back to all articles
      </a>
      <a
        href="/rss.xml"
        class="font-mono text-[12px] uppercase tracking-[0.08em] text-ink-3 no-underline hover:text-accent"
      >
        RSS / atom.xml
      </a>
    </div>
  </section>
</Page>
