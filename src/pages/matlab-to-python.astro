---
import Page from '../layouts/Page.astro'
import Eyebrow from '../components/v5/Eyebrow.astro'
import Tag from '../components/v5/Tag.astro'
import Btn from '../components/v5/Btn.astro'

const title = 'MATLAB → Python migration'
const description =
  'Production-grade migration of MATLAB code to Python. Any math, any domain. By an engineer with 20+ years across power systems, embedded, and ML.'

const calendlyUrl = 'https://cal.eu/evgenyistomin'
const formspreeUrl = 'https://formspree.io/f/meedlkjb'
const contactEmail = 'hello@alpisto.eu'

const receipt: [string, string][] = [
  ['Service', 'MATLAB → Python migration'],
  ['Start', '1-week paid audit · fixed fee'],
  ['Pilot', '2–4 weeks · fixed scope'],
  ['Migration', 'Rolling · milestone-billed'],
  ['Currency', 'EUR'],
  ['Pre-NDA', 'Not required for first email'],
  ['Engineer', 'Evgeny Istomin · solo'],
  ['Location', 'Remote · CET'],
]

interface Phase {
  n: string
  label: string
  dur: string
  body: string
  deliverable: string[]
}

const phases: Phase[] = [
  {
    n: '01',
    label: 'Audit',
    dur: '1 week',
    body:
      'Read the MATLAB, document the math, identify risk hotspots. We talk to the original author when possible, run the existing test suite (if any), and produce a written report you can hand to procurement.',
    deliverable: [
      '– Architecture map (PDF)',
      '– Risk matrix per module',
      '– Recommended port order',
      '– Effort estimate ±20%',
    ],
  },
  {
    n: '02',
    label: 'Risk matrix',
    dur: 'part of audit',
    body:
      "Each module classified by math complexity, test coverage, downstream dependencies, and porting risk. The matrix decides what's worth porting first — and what is better left in MATLAB or rewritten from spec.",
    deliverable: ['– Per-module score sheet', '– Go / no-go recommendation', '– Spec-rewrite candidates flagged'],
  },
  {
    n: '03',
    label: 'Pilot module',
    dur: '2–4 weeks · fixed scope',
    body:
      'Port one self-contained piece end-to-end. Tests against the original MATLAB outputs, CI green on day one, documented public API. Proves fit and gives your team a working template.',
    deliverable: [
      '– One module, production-shaped',
      '– pytest + hypothesis suite',
      '– GH Actions CI green',
      '– Sphinx API docs',
    ],
  },
  {
    n: '04',
    label: 'Full migration',
    dur: 'rolling · milestone-billed',
    body:
      'Port the remaining modules at a known velocity. Weekly demos, signed milestones, code review with your team. We stop when the MATLAB licences can be cancelled — or earlier if the spec says so.',
    deliverable: [
      '– Full Python codebase',
      '– Numerical-equivalence test gates',
      '– Migration playbook',
      '– 30-day post-handover support',
    ],
  },
  {
    n: '05',
    label: 'Handover & coaching',
    dur: 'optional · 1–2 weeks',
    body:
      'Your team owns the result. We coach if you want — pair on the first internal changes, set up the code-review patterns, document the gotchas we found along the way.',
    deliverable: [
      '– Pair-programming sessions',
      '– Code-review rubric',
      '– Internal walkthrough video',
      '– Engineering on-call: 30 days',
    ],
  },
]

const stack: [string, string[]][] = [
  ['Math', ['NumPy', 'SciPy', 'pandas', 'numba', 'sparse', 'CVXPY']],
  ['Testing', ['pytest', 'tox', 'hypothesis', 'pytest-xdist', 'coverage']],
  ['CI / hygiene', ['GitHub Actions', 'pre-commit', 'ruff', 'mypy', 'Sphinx']],
  ['Delivery', ['Docker', 'uv / pip-tools', 'semantic-release', 'Pydantic', 'FastAPI']],
]

const faq: [string, string][] = [
  [
    'How much does a 1-week audit cost?',
    'Fixed fee in EUR. We quote in the first email reply once we understand the scope. No discount for promise of follow-up work.',
  ],
  [
    'Do you sign NDAs?',
    "Yes, after the first email exchange. We don't sign NDAs before hello — it wastes everyone's time when the fit isn't there.",
  ],
  [
    'Will you port Simulink?',
    'No. Pure-script MATLAB only, and any Simulink-generated C/C++ helpers if they sit in the same repo. Hardware code-gen is a separate practice we do not run.',
  ],
  [
    'Numerical equivalence — how do you prove it?',
    'Property-based tests with hypothesis, golden-output fixtures against the MATLAB outputs, and a numerical-tolerance gate in CI. We document the tolerance per module.',
  ],
  [
    'Can you work under our existing Python conventions?',
    "Yes. We'll match your linting, packaging and CI choices unless they are actively painful — in which case we flag it before the pilot starts.",
  ],
  [
    'Who actually writes the code?',
    'Evgeny Istomin. The engineer named on the proposal is the engineer writing the commits. No juniors, no offshore subcontract.',
  ],
]
---

<Page title={title} description={description} ogImage="/og-default.png">
  {/* breadcrumb */}
  <div class="px-5 sm:px-10 pt-4 font-mono text-[11px] tracking-[0.08em] uppercase text-ink-3">
    ALPISTO / SERVICES / 01 — MATLAB → PYTHON
  </div>

  {/* HERO */}
  <section class="px-5 sm:px-10 pt-6 pb-8">
    <Eyebrow>
      <span class="flex items-center gap-3"><span>●</span><span>Available now · booking</span></span>
      <span class="flex items-center gap-3"><span>●</span><span>Audit → Pilot → Migration</span></span>
      <span class="flex items-center gap-3"><span>●</span><span>Fixed-fee start</span></span>
    </Eyebrow>
    <h1
      class="font-display font-bold leading-[0.82] tracking-[-0.06em] mt-[18px] text-ink text-[64px] sm:text-[96px] md:text-[140px] lg:text-[184px]"
    >
      MATLAB&nbsp;<span class="text-accent">→</span><br />
      PYTHON<span class="text-accent">.</span>
    </h1>

    <div class="grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:gap-10 mt-9 items-start">
      <div>
        <p class="font-display text-[20px] sm:text-[24px] leading-[1.35] text-ink m-0 font-medium">
          Any math, any domain. Audit, risk matrix, pilot module, full migration.
          From science to <strong class="bg-accent px-[6px] font-medium">production-grade Python</strong>
          with proper testing and CI.
        </p>
        <p class="font-display text-[15px] sm:text-[16px] leading-[1.6] text-ink-2 mt-5 max-w-[620px]">
          Research code that started as a one-engineer prototype hits a wall: nobody
          else can run it, licences cost more than the team, deployment is impossible.
          We move the math to Python — but more importantly, we leave behind tests,
          CI, and a codebase the next hire can read.
        </p>
        <div class="flex flex-wrap gap-3 mt-6">
          <Btn kind="ink" href="#engage">REQUEST AUDIT →</Btn>
          <Btn kind="ghost" href="#stack">SEE STACK ↓</Btn>
        </div>
      </div>

      {/* Receipt */}
      <div class="bg-ink text-paper p-6">
        <Eyebrow color="accent">● Receipt</Eyebrow>
        <table class="w-full border-collapse mt-[14px] font-mono text-[12px]">
          <tbody>
            {receipt.map(([k, v], i) => (
              <tr class:list={[i === 0 ? 'border-t border-accent' : 'border-t border-[#333]']}>
                <td class="py-2 tracking-[0.06em] uppercase w-[110px]" style="color: #aaa;">{k}</td>
                <td class="py-2 text-paper">{v}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <div class="border-t-[1.5px] border-accent mt-[14px] pt-[14px] font-display text-[16px] sm:text-[18px] font-bold text-accent leading-[1.3]">
          ★ One client at a time per pilot.<br />
          <span class="text-paper font-medium text-[14px]">Quality, not throughput.</span>
        </div>
      </div>
    </div>
  </section>

  {/* GOOD FIT / NOT */}
  <section class="px-5 sm:px-10 pt-12 sm:pt-[50px]">
    <div class="grid grid-cols-1 lg:grid-cols-2 border-2 border-ink">
      <div class="p-6 sm:p-7 lg:border-r-2 border-b-2 lg:border-b-0 border-ink bg-paper-card">
        <Eyebrow>● 02 — Good fit if</Eyebrow>
        <ul class="list-none p-0 m-0 mt-[14px] font-display text-[15px] sm:text-[17px] leading-[1.55] text-ink">
          <li class="mb-[10px]">→ You have a MATLAB codebase that one or two people understand.</li>
          <li class="mb-[10px]">→ The math is correct; the engineering is the bottleneck.</li>
          <li class="mb-[10px]">→ You're hiring Python engineers and need a runtime they can actually work in.</li>
          <li class="mb-[10px]">→ Licence costs are starting to look like an extra headcount.</li>
          <li>→ You want tests and CI as part of the deliverable, not as a follow-up project.</li>
        </ul>
      </div>
      <div class="p-6 sm:p-7 bg-paper">
        <Eyebrow color="accent">● 03 — We'll say no if</Eyebrow>
        <ul class="list-none p-0 m-0 mt-[14px] font-display text-[15px] sm:text-[17px] leading-[1.55] text-ink">
          <li class="mb-[10px]">× You want a "wrap-it-and-pray" shim around MATLAB — we won't ship that.</li>
          <li class="mb-[10px]">× The math is unspecified and the audit would discover most of the project.</li>
          <li class="mb-[10px]">× Simulink models with hardware code generation — that's a different practice.</li>
          <li class="mb-[10px]">× Fixed-bid full migration with no audit. We start with the audit, always.</li>
          <li>× Pure "take it offshore and supervise" engagements.</li>
        </ul>
      </div>
    </div>
  </section>

  {/* PHASES */}
  <section id="engage" class="px-5 sm:px-10 pt-14 sm:pt-[60px]">
    <Eyebrow>● 04 — Engagement phases</Eyebrow>
    <h2
      class="font-display font-bold tracking-[-0.04em] leading-[0.95] mt-[14px] mb-2 text-[40px] sm:text-[56px] lg:text-[72px]"
    >
      AUDIT · PILOT · MIGRATE<span class="text-accent">.</span>
    </h2>
    <p class="font-mono text-[12px] text-ink-3 tracking-[0.04em] mb-4">
      You can stop after any phase. Most clients stop after the audit, run the pilot internally, then come back for the bulk migration.
    </p>

    {phases.map((p) => (
      <div
        class="border-t-2 border-ink py-6 grid gap-5 lg:grid-cols-[70px_1fr_1fr_200px] items-start"
      >
        <div class="font-display font-bold leading-[0.9] tracking-[-0.04em] text-ink text-[36px] sm:text-[48px]">{p.n}</div>
        <div>
          <h3 class="font-display text-[22px] sm:text-[28px] font-bold tracking-[-0.025em] leading-[1.05] m-0">
            {p.label}
          </h3>
          <p class="font-display text-[14px] sm:text-[15px] leading-[1.55] text-ink-2 mt-[10px]">{p.body}</p>
        </div>
        <div
          class="font-mono text-[12px] text-ink-2 tracking-[0.04em] bg-paper-card border-[1.5px] border-ink p-[14px] leading-[1.55]"
        >
          <div class="text-[10px] tracking-[0.12em] uppercase text-ink-3 mb-[6px]">You receive</div>
          {p.deliverable.map((line, i) => (
            <>
              {line}
              {i < p.deliverable.length - 1 && <br />}
            </>
          ))}
        </div>
        <div>
          <div class="font-mono text-[10px] tracking-[0.12em] uppercase text-ink-3">Duration</div>
          <div class="font-display text-[22px] sm:text-[26px] font-bold tracking-[-0.02em] mt-[6px]">{p.dur}</div>
        </div>
      </div>
    ))}
  </section>

  {/* STACK */}
  <section id="stack" class="px-5 sm:px-10 pt-14 sm:pt-[70px]">
    <Eyebrow>● 05 — Stack we ship</Eyebrow>
    <h2
      class="font-display font-bold tracking-[-0.04em] leading-[0.95] mt-[14px] mb-6 text-[40px] sm:text-[56px] lg:text-[72px]"
    >
      NOT JUST NUMPY<span class="text-accent">.</span>
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 border-2 border-ink">
      {stack.map(([label, items], i) => (
        <div
          class:list={[
            'p-[22px]',
            i < 3 ? 'lg:border-r-2 border-ink' : '',
            i % 2 === 1 ? 'sm:border-l-2 lg:border-l-0 border-ink' : '',
            i > 1 ? 'sm:border-t-2 lg:border-t-0 border-ink' : '',
            i % 2 === 0 ? 'bg-paper-card' : 'bg-paper',
          ]}
        >
          <div class="font-mono text-[11px] tracking-[0.12em] uppercase text-ink-3">0{i + 1}</div>
          <h3 class="font-display text-[20px] sm:text-[22px] font-bold tracking-[-0.02em] mt-[6px] mb-[14px]">
            {label}
          </h3>
          <div class="flex flex-wrap gap-[6px]">
            {items.map((t) => <Tag>{t}</Tag>)}
          </div>
        </div>
      ))}
    </div>
  </section>

  {/* FAQ */}
  <section id="faq" class="px-5 sm:px-10 pt-14 sm:pt-[70px]">
    <div class="grid gap-8 lg:grid-cols-[1fr_1.6fr] lg:gap-10">
      <div>
        <Eyebrow>● 06 — Honest answers</Eyebrow>
        <h2
          class="font-display font-bold tracking-[-0.04em] leading-[0.95] mt-[14px] text-[40px] sm:text-[56px] lg:text-[72px]"
        >
          FAQ<span class="text-accent">.</span>
        </h2>
      </div>
      <div>
        {faq.map(([q, a], i, arr) => (
          <details
            open={i < 2}
            class:list={[
              'border-t-2 border-ink py-[18px] cursor-pointer group',
              i === arr.length - 1 ? 'border-b-2 border-ink' : '',
            ]}
          >
            <summary class="font-display text-[18px] sm:text-[22px] font-bold tracking-[-0.02em] list-none flex justify-between items-center cursor-pointer">
              <span>{q}</span>
              <span class="font-mono text-[18px] text-accent group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="font-display text-[15px] sm:text-[16px] leading-[1.6] text-ink-2 mt-3 max-w-[760px]">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* CONTACT — form + alt */}
  <section id="contact" class="px-5 sm:px-10 pt-14 sm:pt-[70px]">
    <div class="border-2 border-ink bg-paper-card p-6 sm:p-10">
      <Eyebrow>● 07 — Send a paragraph</Eyebrow>
      <h2
        class="font-display font-bold tracking-[-0.04em] leading-[0.95] mt-[14px] text-[36px] sm:text-[52px] lg:text-[64px]"
      >
        OPEN A FILE<span class="text-accent">.</span>
      </h2>
      <p class="font-display text-[15px] sm:text-[16px] text-ink-2 mt-4 max-w-[640px]">
        Tell us about your codebase — size in lines, domain, current pain. We reply
        within two working days with questions, a suggested call time, or — if it's
        clear we're not the right fit — an honest no.
      </p>

      <div class="grid gap-8 lg:grid-cols-2 lg:gap-12 mt-8 items-start">
        <form action={formspreeUrl} method="POST" class="grid gap-4">
          <div>
            <label for="name" class="block font-mono text-[11px] tracking-[0.1em] uppercase text-ink-3 mb-2">
              Name
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full px-3 py-2 bg-paper border-2 border-ink font-display text-[15px] text-ink focus:outline-none focus:border-accent"
            />
          </div>
          <div>
            <label for="email" class="block font-mono text-[11px] tracking-[0.1em] uppercase text-ink-3 mb-2">
              Email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-3 py-2 bg-paper border-2 border-ink font-display text-[15px] text-ink focus:outline-none focus:border-accent"
            />
          </div>
          <div>
            <label for="project" class="block font-mono text-[11px] tracking-[0.1em] uppercase text-ink-3 mb-2">
              Tell us about your project
            </label>
            <textarea
              id="project"
              name="project"
              rows="5"
              required
              placeholder="Roughly: codebase size, toolboxes used, what you've already considered..."
              class="w-full px-3 py-2 bg-paper border-2 border-ink font-display text-[15px] text-ink resize-y focus:outline-none focus:border-accent"
            ></textarea>
          </div>
          <input type="hidden" name="_subject" value="alpisto.eu — MATLAB landing inquiry" />
          <div>
            <Btn kind="ink" as="button" type="submit">SEND →</Btn>
          </div>
        </form>

        <div class="bg-ink text-paper p-6">
          <Eyebrow color="accent">● Or reach out directly</Eyebrow>
          <ul class="list-none p-0 m-0 mt-4 font-display text-[15px] sm:text-[16px] leading-[1.7]">
            <li>
              →{' '}
              <a href={`mailto:${contactEmail}`} class="text-paper no-underline hover:text-accent">{contactEmail}</a>
            </li>
            <li>
              →{' '}
              <a
                href={calendlyUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-paper no-underline hover:text-accent"
              >
                {calendlyUrl.replace('https://', '')} (book a call)
              </a>
            </li>
            <li>
              →{' '}
              <a
                href="https://www.linkedin.com/in/evgenyistomin"
                target="_blank"
                rel="noopener noreferrer"
                class="text-paper no-underline hover:text-accent"
              >
                linkedin.com/in/evgenyistomin
              </a>
            </li>
          </ul>
          <p
            class="font-mono text-[11px] tracking-[0.04em] leading-[1.55] mt-5"
            style="color: #cfcabf;"
          >
            Alpisto d.o.o. — Slovenian LLC, EU VAT registered (SI91102227).
            Invoiced in EUR via standard reverse-charge for B2B clients within the EU.
            NDAs welcome after first email.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* BOTTOM CTA */}
  <section class="px-5 sm:px-10 pt-14 sm:pt-[70px] pb-14 sm:pb-[60px]">
    <div
      class="border-2 border-ink bg-accent p-6 sm:p-10 grid gap-8 lg:grid-cols-[1.5fr_1fr] lg:items-end"
    >
      <div>
        <Eyebrow>● Ready when you are</Eyebrow>
        <h2
          class="font-display font-bold tracking-[-0.045em] leading-[0.9] mt-[14px] text-ink text-[44px] sm:text-[64px] lg:text-[80px]"
        >
          START WITH<br />THE AUDIT<span class="text-ink">.</span>
        </h2>
        <p class="font-display text-[16px] sm:text-[17px] text-ink mt-[18px] max-w-[640px]">
          Send a paragraph about the codebase — size in lines, domain, current pain.
          We'll reply in ≤ 2 working days with either a quote or an honest no.
        </p>
      </div>
      <div class="flex flex-col gap-[10px] items-start">
        <Btn kind="ink" href={`mailto:${contactEmail}`}>{contactEmail} →</Btn>
        <Btn kind="ghost" href={calendlyUrl} target="_blank" rel="noopener noreferrer">
          cal.eu/evgenyistomin
        </Btn>
        <Btn kind="ghost" href="/case-studies">SEE CASE STUDIES</Btn>
      </div>
    </div>
  </section>
</Page>
