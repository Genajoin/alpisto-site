---
import Page from '../../layouts/Page.astro'
import { getCollection } from 'astro:content'

const cases = (await getCollection('case-studies', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
---

<Page
  title="Case Studies"
  description="Anonymous case studies from Alpisto consulting engagements — MATLAB migration, power systems, embedded firmware, IoT backends."
>
  <section class="max-w-3xl mx-auto px-6 py-16">
    <header class="mb-12">
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 mb-4">Case studies</h1>
      <p class="text-lg text-slate-600 leading-relaxed">
        Anonymous summaries of real engineering work. Client names withheld under NDA;
        technical details generalised but representative.
      </p>
    </header>

    {cases.length === 0 ? (
      <div class="border-t border-slate-200 pt-12 text-center">
        <p class="text-slate-500 mb-2">First case study coming soon.</p>
        <p class="text-sm text-slate-400">
          In the meantime, <a href="mailto:info@alpisto.eu" class="text-blue-600 hover:underline">get in touch</a> and we'll walk you through relevant past work.
        </p>
      </div>
    ) : (
      <ul class="space-y-6">
        {cases.map(c => (
          <li>
            <a
              href={`/case-studies/${c.id}/`}
              class="block p-6 border border-slate-200 rounded-2xl hover:border-slate-900 transition-colors"
            >
              <p class="text-xs font-medium text-blue-600 uppercase tracking-wider mb-2">
                {c.data.industry}{c.data.projectType ? ` · ${c.data.projectType}` : ''}
              </p>
              <h2 class="text-2xl font-semibold text-slate-900 mb-3">{c.data.title}</h2>
              <p class="text-slate-600 leading-relaxed mb-4">{c.data.problem}</p>
              <p class="text-sm text-slate-700">
                <span class="font-medium text-slate-900">Result:</span> {c.data.result}
              </p>
              <p class="text-sm text-blue-600 mt-4">Read case study →</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Page>
