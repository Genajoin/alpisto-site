---
import Page from '../layouts/Page.astro'
import Eyebrow from '../components/v5/Eyebrow.astro'
import Btn from '../components/v5/Btn.astro'
import Subscribe from '../components/v5/Subscribe.astro'

// State is read on the client: the page itself is static, the confirmation
// function redirects here with ?state=expired|invalid|error on failure.
---

<Page
  title="Subscription confirmed"
  description="Your email subscription to the Alpisto blog is confirmed."
>
  <section class="px-5 sm:px-10 pt-10 sm:pt-16 pb-14 sm:pb-20">
    <Eyebrow>
      <span class="flex items-center gap-3"><span>●</span><span>Blog · subscription</span></span>
    </Eyebrow>

    <div data-state="ok">
      <h1
        class="font-display font-bold leading-[0.86] tracking-[-0.05em] text-ink mt-4 text-[56px] sm:text-[96px] lg:text-[120px]"
      >
        CONFIRMED<span class="text-accent">.</span>
      </h1>
      <p class="font-display text-[18px] sm:text-[22px] leading-[1.45] text-ink mt-6 max-w-[720px] font-medium">
        You'll get an email when a new article goes up — roughly one per post, nothing else.
        Every email has an unsubscribe link that actually works.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Btn kind="ink" href="/blog">Read the blog →</Btn>
        <Btn kind="ghost" href="/rss.xml">RSS / atom.xml</Btn>
      </div>
    </div>

    <div data-state="expired" class="hidden">
      <h1
        class="font-display font-bold leading-[0.86] tracking-[-0.05em] text-ink mt-4 text-[56px] sm:text-[96px] lg:text-[120px]"
      >
        EXPIRED<span class="text-accent">.</span>
      </h1>
      <p class="font-display text-[18px] sm:text-[22px] leading-[1.45] text-ink mt-6 max-w-[720px] font-medium">
        That confirmation link was older than three days, so it no longer works. Ask for a fresh
        one — it takes a second.
      </p>
      <Subscribe class="mt-8 max-w-[720px]" />
    </div>

    <div data-state="invalid" class="hidden">
      <h1
        class="font-display font-bold leading-[0.86] tracking-[-0.05em] text-ink mt-4 text-[56px] sm:text-[96px] lg:text-[120px]"
      >
        BAD LINK<span class="text-accent">.</span>
      </h1>
      <p class="font-display text-[18px] sm:text-[22px] leading-[1.45] text-ink mt-6 max-w-[720px] font-medium">
        That link could not be verified — usually it got mangled by an email client. Try
        subscribing again below.
      </p>
      <Subscribe class="mt-8 max-w-[720px]" />
    </div>

    <div data-state="error" class="hidden">
      <h1
        class="font-display font-bold leading-[0.86] tracking-[-0.05em] text-ink mt-4 text-[56px] sm:text-[96px] lg:text-[120px]"
      >
        OUR FAULT<span class="text-accent">.</span>
      </h1>
      <p class="font-display text-[18px] sm:text-[22px] leading-[1.45] text-ink mt-6 max-w-[720px] font-medium">
        Something broke on our side while confirming you. Write to
        <a href="mailto:hello@alpisto.eu" class="underline">hello@alpisto.eu</a> and I'll add you by
        hand.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Btn kind="ink" href="/blog">Back to the blog →</Btn>
      </div>
    </div>

    <div class="mt-10 font-mono text-[12px] uppercase tracking-[0.08em] text-ink-3">
      ↳ alpisto.eu · Tolmin, SI
    </div>
  </section>
</Page>

<script>
  const allowed = ['ok', 'expired', 'invalid', 'error'] as const
  const requested = new URL(window.location.href).searchParams.get('state') ?? 'ok'
  const state = (allowed as readonly string[]).includes(requested) ? requested : 'ok'

  document.querySelectorAll<HTMLElement>('[data-state]').forEach(block => {
    block.classList.toggle('hidden', block.dataset.state !== state)
  })
</script>
